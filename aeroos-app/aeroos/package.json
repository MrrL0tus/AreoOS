{
  "name": "aeroos",
  "version": "0.1.0",
  "private": true,
  "description": "AeroOS — Plateforme de gestion des actifs aéronautiques",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:rls": "psql \"$DATABASE_URL\" -f prisma/rls.sql",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:rls && npm run db:seed",
    "setup": "npm run db:up && sleep 4 && npm run db:generate && npm run db:migrate -- --name init && npm run db:rls && npm run db:seed",
    "alerts:run": "tsx scripts/run-alerts.ts",
    "valuation:refresh": "tsx scripts/refresh-valuations.ts",
    "sanctions:import": "tsx scripts/import-sanctions-list.ts",
    "sanctions:screen": "tsx scripts/screen-operators.ts",
    "retention:purge": "tsx scripts/retention-purge.ts",
    "test:isolation": "tsx scripts/test-tenant-isolation.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^15.1.0",
    "otplib": "^12.0.1",
    "papaparse": "^5.6.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
