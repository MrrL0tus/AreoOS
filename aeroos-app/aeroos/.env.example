# ─── Base de données ────────────────────────────────────────────
# En local via docker compose (npm run db:up)
# DATABASE_URL : rôle applicatif non-superuser (RLS appliqué, cf. prisma/rls.sql §6)
# Créer ce rôle après npm run db:rls :
#   CREATE ROLE aeroos_app WITH LOGIN PASSWORD '<mot-de-passe>' NOSUPERUSER NOBYPASSRLS;
#   GRANT CONNECT ON DATABASE aeroos TO aeroos_app;
#   GRANT USAGE ON SCHEMA public TO aeroos_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO aeroos_app;
#   GRANT USAGE ON ALL SEQUENCES IN SCHEMA public TO aeroos_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO aeroos_app;
DATABASE_URL="postgresql://aeroos_app:CHANGEZ_MOI@localhost:5432/aeroos?schema=public"
# ADMIN_DATABASE_URL : superuser, réservé aux migrations et aux scripts
# d'amorçage (seed, test:isolation) qui doivent contourner le RLS pour
# créer des tenants avant qu'un contexte tenant n'existe.
ADMIN_DATABASE_URL="postgresql://aeroos:aeroos_dev_password@localhost:5432/aeroos?schema=public"
# SYSTEM_DATABASE_URL : rôle applicatif BYPASSRLS (pas superuser), utilisé
# uniquement par asSystem() dans src/lib/db.ts pour les opérations qui
# doivent légitimement traverser les tenants (ex. login() qui cherche un
# utilisateur par e-mail avant de connaître son tenant). Créer ce rôle :
#   CREATE ROLE aeroos_system WITH LOGIN PASSWORD '<mot-de-passe>' NOSUPERUSER BYPASSRLS;
#   GRANT CONNECT ON DATABASE aeroos TO aeroos_system;
#   GRANT USAGE ON SCHEMA public TO aeroos_system;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO aeroos_system;
#   GRANT USAGE ON ALL SEQUENCES IN SCHEMA public TO aeroos_system;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO aeroos_system;
SYSTEM_DATABASE_URL="postgresql://aeroos_system:CHANGEZ_MOI@localhost:5432/aeroos?schema=public"

# ─── Authentification ───────────────────────────────────────────
# Générer une clé : openssl rand -base64 32
AUTH_SECRET="CHANGEZ_MOI_openssl_rand_base64_32"
# Durée du cookie de session (fenêtre glissante, renouvelée tant que
# l'utilisateur est actif — cf. src/components/SessionRenewer.tsx). Le
# plafond absolu de 12h depuis la connexion initiale n'est pas
# configurable (cf. lib/auth.ts, ABSOLUTE_SESSION_SECONDS).
SESSION_MAX_AGE_SECONDS=900

# ─── Application ────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="AeroOS"

# ─── Intelligence artificielle (cf. src/lib/ai/) ─────────────────
# Extraction de contrats (T3.1). L'IA propose, l'humain valide (cf.
# CLAUDE.md règle 4) — aucune extraction n'écrit LeaseContract
# directement, quel que soit le niveau de confiance.
ANTHROPIC_API_KEY="CHANGEZ_MOI"

# ─── Stockage documentaire (cf. src/lib/storage.ts) ──────────────
# local : filesystem sous ./storage-local (dev, pas de chiffrement au
#   repos — limite documentée, cf. T2.5). s3 : chiffrement SSE-S3.
STORAGE_DRIVER="local"
# LOCAL_STORAGE_PATH="./storage-local"   # optionnel, dérivé sinon
# S3_BUCKET="aeroos-documents-prod"
# S3_REGION="eu-west-1"
