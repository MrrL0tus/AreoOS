# ─── Base de données ────────────────────────────────────────────
# En local via docker compose (npm run db:up)
DATABASE_URL="postgresql://aeroos:aeroos_dev_password@localhost:5432/aeroos?schema=public"

# ─── Authentification ───────────────────────────────────────────
# Générer une clé : openssl rand -base64 32
AUTH_SECRET="CHANGEZ_MOI_openssl_rand_base64_32"
SESSION_MAX_AGE_SECONDS=900

# ─── Application ────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="AeroOS"
